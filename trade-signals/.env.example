# Copy to .env (never commit .env) and fill in. launchd does not see your shell's
# exports, so the scripts read this file instead.

# ntfy topic: works like a password. Make it long and random, e.g. the output of:
#   python3 -c "import secrets; print('sharath-' + secrets.token_hex(12))"
NTFY_TOPIC=

# Notion internal integration secret (https://www.notion.so/my-integrations)
NOTION_TOKEN=
